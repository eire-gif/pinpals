{
  "expo": {
    "name": "PinPals",
    "slug": "pinpals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinpals",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f3ea",
    "ios": {
      "bundleIdentifier": "ie.pinpals.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:www.pinpals.ie",
        "applinks:pinpals.ie"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PinPals uses your location to show tee times at courses near you.",
        "NSCameraUsageDescription": "PinPals uses your camera to photograph clubs you are listing for sale.",
        "NSPhotoLibraryUsageDescription": "PinPals uses your photo library to attach photos to a listing.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ie.pinpals.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c2038",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.pinpals.ie"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c2038",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PinPals uses your location to show tee times at courses near you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PinPals uses your photo library to attach photos to a listing.",
          "cameraPermission": "PinPals uses your camera to photograph clubs you are listing for sale."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1f5c2e"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "url": "https://u.expo.dev/545241c8-de3f-4d9f-9371-bd8a9e09a2d3"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "extra": {
      "supabaseUrl": "https://cicluiabimxklgmpmxmn.supabase.co",
      "supabasePublishableKey": "sb_publishable_giwug07R44boQ2DZwJ5cMg_h3j4xZs-",
      "siteUrl": "https://www.pinpals.ie",
      "router": {},
      "eas": {
        "projectId": "545241c8-de3f-4d9f-9371-bd8a9e09a2d3"
      }
    },
    "owner": "pinpals"
  }
}
