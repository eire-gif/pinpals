{
  "expo": {
    "name": "PinPals",
    "slug": "pinpals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pinpals",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f3ea",
    "ios": {
      "bundleIdentifier": "ie.pinpals.app",
      "appleTeamId": "8UEGCT8434",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:www.pinpals.ie",
        "applinks:pinpals.ie"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PinPals uses your location to show tee times near you and your distance to the green.",
        "NSCameraUsageDescription": "PinPals uses your camera to take photos and videos for your posts and listings.",
        "NSPhotoLibraryUsageDescription": "PinPals uses your photo library to add photos and videos to your posts and listings.",
        "NSMicrophoneUsageDescription": "PinPals uses your microphone to record sound with videos you post, and to hear the scores you say on the course.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSpeechRecognitionUsageDescription": "PinPals turns the scores you say on the course into your scorecard.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "During a live round, PinPals keeps your distance to the green up to date on your lock screen. It stops when the round ends."
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.ie.pinpals.app"
        ]
      }
    },
    "android": {
      "package": "ie.pinpals.app",
      "adaptiveIcon": {
        "backgroundColor": "#0c2038",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "www.pinpals.ie"
            },
            {
              "path": "/feed"
            },
            {
              "pathPrefix": "/feed/"
            },
            {
              "pathPrefix": "/s/"
            },
            {
              "pathPrefix": "/invite/"
            },
            {
              "path": "/auth/confirm"
            },
            {
              "path": "/inbox"
            },
            {
              "path": "/conversations"
            },
            {
              "pathPrefix": "/conversations/"
            },
            {
              "path": "/tee-times"
            },
            {
              "pathPrefix": "/tee-times/"
            },
            {
              "path": "/marketplace"
            },
            {
              "pathPrefix": "/marketplace/"
            },
            {
              "path": "/dashboard"
            },
            {
              "pathPrefix": "/dashboard/listings"
            },
            {
              "pathPrefix": "/dashboard/selling"
            },
            {
              "pathPrefix": "/dashboard/buying"
            },
            {
              "path": "/dashboard/payouts"
            },
            {
              "pathPrefix": "/dashboard/connections"
            },
            {
              "pathPrefix": "/dashboard/profile"
            },
            {
              "pathPrefix": "/dashboard/notifications"
            },
            {
              "pathPrefix": "/dashboard/availability"
            },
            {
              "path": "/members"
            },
            {
              "pathPrefix": "/members/"
            },
            {
              "path": "/community"
            },
            {
              "pathPrefix": "/live/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0c2038",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PinPals uses your location to show tee times near you and your distance to the green.",
          "locationAlwaysAndWhenInUsePermission": "During a live round, PinPals keeps your distance to the green up to date on your lock screen. It stops when the round ends.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PinPals uses your photo library to add photos and videos to your posts and listings.",
          "cameraPermission": "PinPals uses your camera to take photos and videos for your posts and listings.",
          "microphonePermission": "PinPals uses your microphone to record sound with videos you post, and to hear the scores you say on the course."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1f5c2e"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/@expo-google-fonts/playfair-display/700Bold/PlayfairDisplay_700Bold.ttf",
              "./node_modules/@expo-google-fonts/playfair-display/700Bold_Italic/PlayfairDisplay_700Bold_Italic.ttf",
              "./node_modules/@expo-google-fonts/public-sans/400Regular/PublicSans_400Regular.ttf",
              "./node_modules/@expo-google-fonts/public-sans/600SemiBold/PublicSans_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/public-sans/700Bold/PublicSans_700Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PinPals uses your microphone to record sound with videos you post, and to hear the scores you say on the course.",
          "speechRecognitionPermission": "PinPals turns the scores you say on the course into your scorecard.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-video",
      "@bacons/apple-targets",
      "./plugins/with-wear-os"
    ],
    "experiments": {
      "typedRoutes": true
