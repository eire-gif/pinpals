{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "image": "sdk-57"
      },
      "android": {
        "image": "latest"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium",
        "image": "sdk-57"
      },
      "android": {
        "buildType": "apk",
        "image": "latest"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "image": "sdk-57"
      },
      "android": {
        "image": "latest"
      }
    },
    "wear-preview": {
      "extends": "preview",
      "channel": "preview",
      "android": {
        "gradleCommand": ":wear:assembleRelease",
        "applicationArchivePath": "wear/build/outputs/apk/release/*.apk",
        "image": "latest"
      }
    },
    "wear-production": {
      "extends": "production",
      "channel": "production",
      "android": {
        "gradleCommand": ":wear:bundleRelease",
        "applicationArchivePath": "wear/build/outputs/bundle/release/*.aab",
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
